    "@mui/material": "9.5.0",
    "@radix-ui/themes": "3.3.0",
    "clsx": "2.1.1",
    "konsta": "5.5.0",
    "lucide-react": "^1.43.0",
    "radix-ui": "1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.13.4",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.2",
    "tailwindcss": "4.1.17",
