# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "jason_dev_agent"
timeout_seconds: 300

cases {
  name: "jason_dev_agent_triggers_and_executes_primary_workflow"
  prompt: "Use the jason-dev-agent skill to execute its developer coordination workflow and run all required evaluation receipts.\n"
  expectations:
    "The agent must:\n"
    "- Load and follow jason-dev-agent/SKILL.md\n"
    "- Execute the deterministic receipt runner run_dev_loop.py\n"
    "- Verify all output invariants before completing the turn"
  expectations: "Agent output references jason-dev-agent or its developer receipts"
}

cases {
  name: "jason_dev_agent_enforces_quality_gates_and_references"
  prompt: "Run a full verification audit with jason-dev-agent across all 9 stage gates.\n"
  expectations:
    "The agent must:\n"
    "- Consult the bundled references/ guides when verifying stage gates\n"
    "- Report pass/fail status against the skill's verification checklist"
  expectations: "Agent output includes concrete verification results"
}
