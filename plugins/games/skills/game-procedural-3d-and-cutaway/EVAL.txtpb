# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "game_procedural_3d_and_cutaway"
timeout_seconds: 300

cases {
  name: "game_procedural_3d_and_cutaway_triggers_and_executes_primary_workflow"
  prompt: "Use the game-procedural-3d-and-cutaway skill to execute its primary workflow and verify all required outputs and quality gates.\n"
  expectations:
    "The agent must:\n"
    "- Load and follow game-procedural-3d-and-cutaway/SKILL.md\n"
    "- Execute the deterministic workflow or bundled scripts in game-procedural-3d-and-cutaway\n"
    "- Verify all output invariants before completing the turn"
  expectations: "Agent output references game-procedural-3d-and-cutaway or its primary deliverables"
}

cases {
  name: "game_procedural_3d_and_cutaway_enforces_quality_gates_and_references"
  prompt: "Run a full verification audit with game-procedural-3d-and-cutaway and check all reference invariants.\n"
  expectations:
    "The agent must:\n"
    "- Consult the bundled references/ guides when verifying edge cases\n"
    "- Report pass/fail status against the skill's verification checklist"
  expectations: "Agent output includes concrete verification results"
}
