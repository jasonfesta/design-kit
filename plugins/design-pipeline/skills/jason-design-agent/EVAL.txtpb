# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "jason_design_agent"
timeout_seconds: 300

cases {
  name: "jason_design_agent_triggers_and_executes_primary_workflow"
  prompt: "Use the jason-design-agent skill to execute its primary workflow and verify all required outputs and quality gates.\n"
  expectations:
    "The agent must:\n"
    "- Load and follow jason-design-agent/SKILL.md\n"
    "- Execute the deterministic workflow or bundled scripts in jason-design-agent\n"
    "- Verify all output invariants before completing the turn"
  expectations: "Agent output references jason-design-agent or its primary deliverables"
}

cases {
  name: "jason_design_agent_enforces_quality_gates_and_references"
  prompt: "Run a full verification audit with jason-design-agent and check all reference invariants.\n"
  expectations:
    "The agent must:\n"
    "- Consult the bundled references/ guides when verifying edge cases\n"
    "- Report pass/fail status against the skill's verification checklist"
  expectations: "Agent output includes concrete verification results"
}
