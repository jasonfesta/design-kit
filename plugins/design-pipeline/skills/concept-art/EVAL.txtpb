# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "concept_art"
timeout_seconds: 300

cases {
  name: "concept_art_triggers_and_executes_primary_workflow"
  prompt: "Use the concept-art skill to execute its primary workflow and verify all required outputs and quality gates.\n"
  expectations:
    "The agent must:\n"
    "- Load and follow concept-art/SKILL.md\n"
    "- Execute the deterministic workflow or bundled scripts in concept-art\n"
    "- Verify all output invariants before completing the turn"
  expectations: "Agent output references concept-art or its primary deliverables"
}

cases {
  name: "concept_art_enforces_quality_gates_and_references"
  prompt: "Run a full verification audit with concept-art and check all reference invariants.\n"
  expectations:
    "The agent must:\n"
    "- Consult the bundled references/ guides when verifying edge cases\n"
    "- Report pass/fail status against the skill's verification checklist"
  expectations: "Agent output includes concrete verification results"
}
