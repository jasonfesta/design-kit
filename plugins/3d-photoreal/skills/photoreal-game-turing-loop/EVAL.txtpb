# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "photoreal_game_turing_loop"
timeout_seconds: 300

cases {
  name: "photoreal_game_turing_loop_triggers_and_executes_primary_workflow"
  prompt: "Use the photoreal-game-turing-loop skill to execute its primary workflow and verify all required outputs and quality gates.\n"
  expectations:
    "The agent must:\n"
    "- Load and follow photoreal-game-turing-loop/SKILL.md\n"
    "- Execute the deterministic workflow or bundled scripts in photoreal-game-turing-loop\n"
    "- Verify all output invariants before completing the turn"
  expectations: "Agent output references photoreal-game-turing-loop or its primary deliverables"
}

cases {
  name: "photoreal_game_turing_loop_enforces_quality_gates_and_references"
  prompt: "Run a full verification audit with photoreal-game-turing-loop and check all reference invariants.\n"
  expectations:
    "The agent must:\n"
    "- Consult the bundled references/ guides when verifying edge cases\n"
    "- Report pass/fail status against the skill's verification checklist"
  expectations: "Agent output includes concrete verification results"
}
