suite_name: "declarative_photoreal_threejs_worlds"
timeout_seconds: 300

cases {
  name: "declarative_photoreal_threejs_worlds_triggers_and_executes_primary_workflow"
  prompt: "Use the declarative-photoreal-threejs-worlds skill to execute its primary workflow and verify all required outputs and quality gates.\n"
  expectations:
    "The agent must:\n"
    "- Load and follow declarative-photoreal-threejs-worlds/SKILL.md\n"
    "- Execute the deterministic workflow or bundled scripts in declarative-photoreal-threejs-worlds\n"
    "- Verify all output invariants before completing the turn"
  expectations: "Agent output references declarative-photoreal-threejs-worlds or its primary deliverables"
}

cases {
  name: "declarative_photoreal_threejs_worlds_enforces_quality_gates_and_references"
  prompt: "Run a full verification audit with declarative-photoreal-threejs-worlds and check all reference invariants.\n"
  expectations:
    "The agent must:\n"
    "- Consult the bundled references/ guides when verifying edge cases\n"
    "- Report pass/fail status against the skill's verification checklist"
  expectations: "Agent output includes concrete verification results"
}
